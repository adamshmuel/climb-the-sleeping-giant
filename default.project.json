{
  "name": "MyRobloxGame",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": { "Shared": { "$path": "src/shared" }, "Packages": { "$path": "Packages" } },
    "ServerScriptService": { "Server": { "$path": "src/server" } },
    "ServerStorage": { "Tests": { "$path": "src/tests" }, "DevPackages": { "$path": "DevPackages" } },
    "StarterPlayer": {
      "$properties": { "CharacterMaxSlopeAngle": 70, "AutoJumpEnabled": false },
      "StarterPlayerScripts": { "Client": { "$path": "src/client" } }
    },
    "SoundService": { "$properties": { "RespectFilteringEnabled": true } }
  }
}
