{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"attribution": { "commit": "", "pr": "", "sessionUrl": false },
	"includeGitInstructions": false,
	"permissions": {
		"allow": [
			"mcp__Roblox_Studio__list_roblox_studios",
			"mcp__Roblox_Studio__get_studio_state",
			"mcp__Roblox_Studio__script_read",
			"mcp__Roblox_Studio__script_grep",
			"mcp__Roblox_Studio__script_search",
			"mcp__Roblox_Studio__search_game_tree",
			"mcp__Roblox_Studio__inspect_instance",
			"mcp__Roblox_Studio__get_console_output",
			"mcp__Roblox_Studio__screen_capture",
			"mcp__Roblox_Studio__http_get",
			"mcp__Roblox_Studio__skill",
			"Bash(stylua:*)",
			"Bash(selene:*)",
			"Bash(rojo build:*)",
			"Bash(rojo sourcemap:*)",
			"Bash(curl -s https://create.roblox.com/docs/*)",
			"mcp__Roblox_Studio__start_stop_play",
			"mcp__Roblox_Studio__character_navigation",
			"mcp__Roblox_Studio__user_keyboard_input",
			"mcp__Roblox_Studio__user_mouse_input",
			"mcp__Roblox_Studio__execute_luau",
			"Bash(rojo serve:*)"
		],
		"deny": ["mcp__Roblox_Studio__multi_edit"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/luau-check.sh"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/job-check-hook.py"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-idle-stop.py"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-guides.py"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/task-clock.py"
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|compact",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.py"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Agent",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/task-clock.py"
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-guides.py"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rojo-safe-delete.py"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-osascript.py"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-guard.py"
					}
				]
			},
			{
				"matcher": "mcp__Roblox_Studio__execute_luau",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/luau-paren-line.py"
					}
				]
			}
		]
	}
}
