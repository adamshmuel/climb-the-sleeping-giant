{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"attribution": { "commit": "", "pr": "", "sessionUrl": false },
	"includeGitInstructions": false,
	"worktree": { "symlinkDirectories": ["work"] },
	"permissions": {
		"allow": [
			"mcp__Roblox_Studio__list_roblox_studios",
			"mcp__Roblox_Studio__get_studio_state",
			"mcp__Roblox_Studio__script_read",
			"mcp__Roblox_Studio__script_grep",
			"mcp__Roblox_Studio__script_search",
			"mcp__Roblox_Studio__search_game_tree",
			"mcp__Roblox_Studio__inspect_instance",
			"mcp__Roblox_Studio__get_console_output",
			"mcp__Roblox_Studio__screen_capture",
			"mcp__Roblox_Studio__http_get",
			"mcp__Roblox_Studio__skill",
			"Bash(stylua:*)",
			"Bash(selene:*)",
			"Bash(rojo build:*)",
			"Bash(rojo sourcemap:*)",
			"Bash(curl -s https://create.roblox.com/docs/*)",
			"mcp__Roblox_Studio__start_stop_play",
			"mcp__Roblox_Studio__character_navigation",
			"mcp__Roblox_Studio__user_keyboard_input",
			"mcp__Roblox_Studio__user_mouse_input",
			"mcp__Roblox_Studio__execute_luau",
			"Bash(rojo serve:*)",
			"mcp__Roblox_Studio__generate_mesh",
			"mcp__Roblox_Studio__wait_job_finished",
			"WebSearch",
			"WebFetch(domain:www.anthropic.com)",
			"WebFetch(domain:create.roblox.com)",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:devforum.roblox.com)",
			"WebFetch(domain:luau.org)",
			"WebFetch(domain:roblox.github.io)",
			"WebFetch(domain:about.roblox.com)",
			"WebFetch(domain:rojo.space)"
		],
		"deny": ["mcp__Roblox_Studio__multi_edit", "Bash(git push *)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/luau-check.sh"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/job-check-hook.py"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/file-size.py"
						},
						{
							"type": "command",
							"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-check.py"
						},
						{
							"type": "command",
							"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/work-tidy.py"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-lint.py"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-idle-stop.py"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-guides.py"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/task-clock.py"
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|clear|compact",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.py"
					}
				]
			},
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/work-tidy.py",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guides-check.py",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "startup|resume|compact",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-place.py"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Agent",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/task-clock.py",
						"onFailure": "continue"
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-guides.py",
						"onFailure": "block"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rojo-safe-delete.py",
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-osascript.py",
							"onFailure": "block"
					},
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-guard.py",
						"onFailure": "block"
					}
				]
			},
			{
				"matcher": "mcp__Roblox_Studio__execute_luau",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/luau-paren-line.py",
							"onFailure": "block"
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__Roblox_Studio__.*|mcp__ccd_session__start_session",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-place.py",
						"onFailure": "block"
					}
				]
			}
		]
	}
}
